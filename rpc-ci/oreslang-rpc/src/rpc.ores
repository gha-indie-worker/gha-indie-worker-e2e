// Transport-neutral RPC contracts for Oreslang.
//
// This module contains only data/validation/conversion logic. It does not use
// Java interop, reflection, sockets, files, or host closures. HTTP transports,
// gRPC transports, CLIs, and build tools consume the same contract graph.

define module rpc as

  // Type kinds:
  // 0 string, 1 bool, 2 int32, 3 int64, 4 float32, 5 float64,
  // 6 bytes, 7 named message, 8 timestamp, 9 any/json value.
  pub define class TypeRef as
    pub val int kind;
    pub val String name;

    pub is_named(): bool {
      return self.kind == 7;
    }

    pub is_valid(): bool {
      if self.kind < 0 || self.kind > 9; then
        return false;
      fi
      if self.kind == 7 && self.name == ""; then
        return false;
      fi
      return true;
    }
  end

  // number_text is intentionally stored beside number. The current pure
  // Oreslang stdlib does not yet expose a stable int->String formatting API;
  // keeping the canonical decimal token in the contract lets protobuf and
  // MessagePack IDL emission remain host-independent.
  pub define class FieldDef as
    pub val String name;
    pub val int number;
    pub val String number_text;
    pub val TypeRef type_value;
    pub val bool required;
    pub val bool repeated;

    pub type_kind(): int {
      return self.type_value.kind;
    }

    pub type_name(): String {
      return self.type_value.name;
    }

    pub is_valid(): bool {
      if self.name == ""; then
        return false;
      fi
      if self.number <= 0 || self.number > 536870911 || self.number_text == ""; then
        return false;
      fi
      // Protocol Buffers reserves 19000..19999 for its own implementation.
      if self.number >= 19000 && self.number <= 19999; then
        return false;
      fi
      return self.type_value.is_valid();
    }
  end

  pub define class MessageDef as
    pub val String name;
    val Array<FieldDef> fields_value;

    pub field_count(): int {
      return self.fields_value.size;
    }

    pub field_at(int index): FieldDef {
      return self.fields_value.get(index);
    }

    pub field_named(String name): Option<FieldDef> {
      for (const field_value of self.fields_value) {
        if field_value.name == name; then
          return Some(field_value);
        fi
      }
      return None;
    }

    pub is_valid(): bool {
      if self.name == ""; then
        return false;
      fi

      for (let int index = 0; index < self.field_count(); index = index + 1) {
        val FieldDef field_value = self.fields_value.get(index);
        if !field_value.is_valid(); then
          return false;
        fi

        for (let int earlier = 0; earlier < index; earlier = earlier + 1) {
          val FieldDef previous = self.fields_value.get(earlier);
          if previous.name == field_value.name || previous.number == field_value.number; then
            return false;
          fi
        }
      }

      return true;
    }
  end

  // streaming kinds:
  // 0 unary, 1 server streaming, 2 client streaming, 3 bidirectional.
  pub define class RpcMethodDef as
    pub val int contract_id;
    pub val String service;
    pub val String name;
    pub val String operation_id;
    pub val String request_type;
    pub val String response_type;
    pub val int streaming_kind;

    pub is_valid(): bool {
      if self.contract_id < 0; then
        return false;
      fi
      if self.service == "" || self.name == "" || self.operation_id == ""; then
        return false;
      fi
      if self.request_type == "" || self.response_type == ""; then
        return false;
      fi
      return self.streaming_kind >= 0 && self.streaming_kind <= 3;
    }
  end

  // A transport-neutral description of an HTTP handler. This deliberately
  // mirrors oreslang-http-routing RouteTarget metadata:
  // handler_id, pipeline_id, contract_id, and operation_id.
  pub define class HttpHandlerDef as
    pub val String method;
    pub val String path_template;
    pub val int handler_id;
    pub val int pipeline_id;
    pub val int contract_id;
    pub val String operation_id;
    pub val String rpc_service;
    pub val String rpc_name;
    pub val String request_type;
    pub val String response_type;
    pub val int streaming_kind;

    pub is_valid(): bool {
      if self.method == "" || self.path_template == ""; then
        return false;
      fi
      if self.method != "GET" &&
         self.method != "POST" &&
         self.method != "PUT" &&
         self.method != "PATCH" &&
         self.method != "DELETE" &&
         self.method != "HEAD"; then
        return false;
      fi
      if self.handler_id < 0 || self.contract_id < 0; then
        return false;
      fi
      if self.operation_id == "" || self.rpc_service == "" || self.rpc_name == ""; then
        return false;
      fi
      if self.request_type == "" || self.response_type == ""; then
        return false;
      fi
      return self.streaming_kind >= 0 && self.streaming_kind <= 3;
    }
  end

  // HTTP request-field locations:
  // 0 path, 1 query, 2 header, 3 cookie.
  //
  // Fields without an explicit binding remain payload/body data. Keeping these
  // bindings separate from MessageDef means the same logical RPC request type
  // can be exposed through more than one HTTP shape without contaminating the
  // transport-neutral message schema.
  pub define class HttpFieldBindingDef as
    pub val int contract_id;
    pub val String field_name;
    pub val String wire_name;
    pub val int location;

    pub is_valid(): bool {
      if self.contract_id < 0; then
        return false;
      fi
      if self.field_name == "" || self.wire_name == ""; then
        return false;
      fi
      return self.location >= 0 && self.location <= 3;
    }
  end

  pub define class ServiceDef as
    pub val String name;
    val Array<RpcMethodDef> methods_value;

    pub method_count(): int {
      return self.methods_value.size;
    }

    pub method_at(int index): RpcMethodDef {
      return self.methods_value.get(index);
    }
  end

  pub define class ContractSet as
    val Array<MessageDef> messages_value;
    val Array<RpcMethodDef> methods_value;
    val Array<HttpHandlerDef> http_handlers_value;
    val Array<HttpFieldBindingDef> http_field_bindings_value;

    pub message_count(): int {
      return self.messages_value.size;
    }

    pub message_at(int index): MessageDef {
      return self.messages_value.get(index);
    }

    pub method_count(): int {
      return self.methods_value.size;
    }

    pub method_at(int index): RpcMethodDef {
      return self.methods_value.get(index);
    }

    pub http_handler_count(): int {
      return self.http_handlers_value.size;
    }

    pub http_handler_at(int index): HttpHandlerDef {
      return self.http_handlers_value.get(index);
    }

    pub http_field_binding_count(): int {
      return self.http_field_bindings_value.size;
    }

    pub http_field_binding_at(int index): HttpFieldBindingDef {
      return self.http_field_bindings_value.get(index);
    }

    pub http_field_binding(int contract_id, String field_name): Option<HttpFieldBindingDef> {
      for (const binding_value of self.http_field_bindings_value) {
        if binding_value.contract_id == contract_id &&
           binding_value.field_name == field_name; then
          return Some(binding_value);
        fi
      }
      return None;
    }

    pub message_named(String name): Option<MessageDef> {
      for (const message_value of self.messages_value) {
        if message_value.name == name; then
          return Some(message_value);
        fi
      }
      return None;
    }

    pub method_by_contract(int contract_id): Option<RpcMethodDef> {
      for (const method_value of self.methods_value) {
        if method_value.contract_id == contract_id; then
          return Some(method_value);
        fi
      }
      return None;
    }

    pub method_by_operation(String operation_id): Option<RpcMethodDef> {
      for (const method_value of self.methods_value) {
        if method_value.operation_id == operation_id; then
          return Some(method_value);
        fi
      }
      return None;
    }

    pub http_by_contract(int contract_id): Option<HttpHandlerDef> {
      for (const handler_value of self.http_handlers_value) {
        if handler_value.contract_id == contract_id; then
          return Some(handler_value);
        fi
      }
      return None;
    }
  end

  pub define class ContractBuilder as
    let Array<MessageDef> messages_value = arr[];
    let Array<RpcMethodDef> methods_value = arr[];
    let Array<HttpHandlerDef> http_handlers_value = arr[];
    let Array<HttpFieldBindingDef> http_field_bindings_value = arr[];

    pub message_count(): int {
      return self.messages_value.size;
    }

    pub method_count(): int {
      return self.methods_value.size;
    }

    pub http_handler_count(): int {
      return self.http_handlers_value.size;
    }

    pub http_field_binding_count(): int {
      return self.http_field_bindings_value.size;
    }

    pub add_http_field_binding(HttpFieldBindingDef binding_value): Result<bool, String> {
      if !binding_value.is_valid(); then
        return Err("invalid HTTP field binding");
      fi

      for (const existing of self.http_field_bindings_value) {
        if existing.contract_id == binding_value.contract_id &&
           existing.field_name == binding_value.field_name; then
          return Err("duplicate HTTP field binding");
        fi
      }

      self.http_field_bindings_value.add(binding_value);
      return Ok(true);
    }

    pub add_message(MessageDef message_value): Result<bool, String> {
      if !message_value.is_valid(); then
        return Err("invalid message definition");
      fi

      for (const existing of self.messages_value) {
        if existing.name == message_value.name; then
          return Err("duplicate message name");
        fi
      }

      self.messages_value.add(message_value);
      return Ok(true);
    }

    check_rpc(&RpcMethodDef method_value): Result<bool, String> {
      if !method_value.is_valid(); then
        return Err("invalid RPC method definition");
      fi

      for (const existing of self.methods_value) {
        if existing.contract_id == method_value.contract_id; then
          return Err("duplicate RPC contract_id");
        fi
        if existing.operation_id == method_value.operation_id; then
          return Err("duplicate RPC operation_id");
        fi
        if existing.service == method_value.service && existing.name == method_value.name; then
          return Err("duplicate RPC service/method");
        fi
      }

      return Ok(true);
    }

    check_http(&HttpHandlerDef handler_value): Result<bool, String> {
      if !handler_value.is_valid(); then
        return Err("invalid HTTP handler definition");
      fi

      for (const existing of self.http_handlers_value) {
        if existing.contract_id == handler_value.contract_id; then
          return Err("duplicate HTTP contract_id");
        fi
        if existing.operation_id == handler_value.operation_id; then
          return Err("duplicate HTTP operation_id");
        fi
        if existing.method == handler_value.method && existing.path_template == handler_value.path_template; then
          return Err("duplicate HTTP method/path");
        fi
      }

      return Ok(true);
    }

    pub add_rpc(RpcMethodDef method_value): Result<bool, String> {
      val Result<bool, String> checked = self.check_rpc(&method_value);
      if checked.is_err(); then
        return checked;
      fi
      self.methods_value.add(method_value);
      return Ok(true);
    }

    pub add_http(HttpHandlerDef handler_value): Result<bool, String> {
      val Result<bool, String> checked = self.check_http(&handler_value);
      if checked.is_err(); then
        return checked;
      fi
      self.http_handlers_value.add(handler_value);
      return Ok(true);
    }

    // Transactional: neither collection changes unless both definitions pass.
    pub add_http_as_rpc(HttpHandlerDef handler_value): Result<bool, String> {
      val RpcMethodDef method_value = rpc_from_http(&handler_value);
      val Result<bool, String> http_checked = self.check_http(&handler_value);
      if http_checked.is_err(); then
        return http_checked;
      fi
      val Result<bool, String> rpc_checked = self.check_rpc(&method_value);
      if rpc_checked.is_err(); then
        return rpc_checked;
      fi

      self.http_handlers_value.add(handler_value);
      self.methods_value.add(method_value);
      return Ok(true);
    }

    // Transactional: neither collection changes unless both definitions pass.
    pub add_rpc_as_http(
      RpcMethodDef method_value,
      String http_method,
      String path_template,
      int handler_id,
      int pipeline_id
    ): Result<bool, String> {
      val HttpHandlerDef handler_value = http_from_rpc(
        &method_value,
        http_method,
        path_template,
        handler_id,
        pipeline_id
      );

      val Result<bool, String> rpc_checked = self.check_rpc(&method_value);
      if rpc_checked.is_err(); then
        return rpc_checked;
      fi
      val Result<bool, String> http_checked = self.check_http(&handler_value);
      if http_checked.is_err(); then
        return http_checked;
      fi

      self.methods_value.add(method_value);
      self.http_handlers_value.add(handler_value);
      return Ok(true);
    }

    pub build(): Result<ContractSet, String> {
      // Every named message field must resolve inside this contract set.
      for (const owner_message of self.messages_value) {
        for (let int field_index = 0; field_index < owner_message.field_count(); field_index = field_index + 1) {
          val FieldDef field_value = owner_message.field_at(field_index);
          if field_value.type_value.is_named(); then
            let bool named_type_found = false;
            for (const candidate_message of self.messages_value) {
              if candidate_message.name == field_value.type_value.name; then
                named_type_found = true;
              fi
            }
            if !named_type_found; then
              return Err("message field references an unregistered message type");
            fi
          fi
        }
      }

      // Cross-reference every RPC input/output against the message table.
      for (const method_value of self.methods_value) {
        let bool request_found = false;
        let bool response_found = false;

        for (const message_value of self.messages_value) {
          if message_value.name == method_value.request_type; then
            request_found = true;
          fi
          if message_value.name == method_value.response_type; then
            response_found = true;
          fi
        }

        if !request_found; then
          return Err("RPC request type is not registered");
        fi
        if !response_found; then
          return Err("RPC response type is not registered");
        fi
      }

      // Cross-reference HTTP bindings with RPC identity.
      for (const handler_value of self.http_handlers_value) {
        let bool found = false;
        for (const method_value of self.methods_value) {
          if method_value.contract_id == handler_value.contract_id &&
             method_value.operation_id == handler_value.operation_id; do
            if method_value.service != handler_value.rpc_service ||
               method_value.name != handler_value.rpc_name ||
               method_value.request_type != handler_value.request_type ||
               method_value.response_type != handler_value.response_type ||
               method_value.streaming_kind != handler_value.streaming_kind; do
              return Err("HTTP/RPC contract metadata mismatch");
            fi
            found = true;
          fi
        }
        if !found; then
          return Err("HTTP handler has no matching RPC method");
        fi
      }

      // HTTP metadata bindings must point at a registered HTTP contract and
      // a real field on that contract's RPC request message.
      for (const binding_value of self.http_field_bindings_value) {
        let bool handler_found = false;
        let String request_type_name = "";

        for (const handler_value of self.http_handlers_value) {
          if handler_value.contract_id == binding_value.contract_id; then
            handler_found = true;
            request_type_name = handler_value.request_type;
          fi
        }

        if !handler_found; then
          return Err("HTTP field binding has no matching HTTP handler");
        fi

        let bool request_field_found = false;
        for (const message_value of self.messages_value) {
          if message_value.name == request_type_name; then
            for (let int field_index = 0; field_index < message_value.field_count(); field_index = field_index + 1) {
              val FieldDef request_field = message_value.field_at(field_index);
              if request_field.name == binding_value.field_name; then
                request_field_found = true;
                if binding_value.location == 0 && !request_field.required; then
                  return Err("HTTP path field must be required");
                fi
              fi
            }
          fi
        }

        if !request_field_found; then
          return Err("HTTP field binding references an unknown request field");
        fi
      }

      let Array<MessageDef> messages_copy = arr[];
      let Array<RpcMethodDef> methods_copy = arr[];
      let Array<HttpHandlerDef> http_copy = arr[];
      let Array<HttpFieldBindingDef> http_field_bindings_copy = arr[];

      for (const message_value of self.messages_value) {
        messages_copy.add(message_value);
      }
      for (const method_value of self.methods_value) {
        methods_copy.add(method_value);
      }
      for (const handler_value of self.http_handlers_value) {
        http_copy.add(handler_value);
      }
      for (const binding_value of self.http_field_bindings_value) {
        http_field_bindings_copy.add(binding_value);
      }

      return Ok(new ContractSet(
        messages_copy,
        methods_copy,
        http_copy,
        http_field_bindings_copy
      ));
    }
  end

  pub fnc string_type(): TypeRef {
    return new TypeRef(0, "");
  }

  pub fnc bool_type(): TypeRef {
    return new TypeRef(1, "");
  }

  pub fnc int32_type(): TypeRef {
    return new TypeRef(2, "");
  }

  pub fnc int64_type(): TypeRef {
    return new TypeRef(3, "");
  }

  pub fnc float32_type(): TypeRef {
    return new TypeRef(4, "");
  }

  pub fnc float64_type(): TypeRef {
    return new TypeRef(5, "");
  }

  pub fnc bytes_type(): TypeRef {
    return new TypeRef(6, "");
  }

  pub fnc message_type(String name): TypeRef {
    return new TypeRef(7, name);
  }

  pub fnc timestamp_type(): TypeRef {
    return new TypeRef(8, "");
  }

  pub fnc any_type(): TypeRef {
    return new TypeRef(9, "");
  }

  pub fnc unary_stream(): int {
    return 0;
  }

  pub fnc server_stream(): int {
    return 1;
  }

  pub fnc client_stream(): int {
    return 2;
  }

  pub fnc bidi_stream(): int {
    return 3;
  }

  pub fnc http_path_location(): int {
    return 0;
  }

  pub fnc http_query_location(): int {
    return 1;
  }

  pub fnc http_header_location(): int {
    return 2;
  }

  pub fnc http_cookie_location(): int {
    return 3;
  }

  pub fnc http_field_binding(
    int contract_id,
    String field_name,
    String wire_name,
    int location
  ): HttpFieldBindingDef {
    return new HttpFieldBindingDef(
      contract_id,
      field_name,
      wire_name,
      location
    );
  }

  pub fnc http_path_field(
    int contract_id,
    String field_name,
    String wire_name
  ): HttpFieldBindingDef {
    return http_field_binding(
      contract_id,
      field_name,
      wire_name,
      http_path_location()
    );
  }

  pub fnc http_query_field(
    int contract_id,
    String field_name,
    String wire_name
  ): HttpFieldBindingDef {
    return http_field_binding(
      contract_id,
      field_name,
      wire_name,
      http_query_location()
    );
  }

  pub fnc http_header_field(
    int contract_id,
    String field_name,
    String wire_name
  ): HttpFieldBindingDef {
    return http_field_binding(
      contract_id,
      field_name,
      wire_name,
      http_header_location()
    );
  }

  pub fnc http_cookie_field(
    int contract_id,
    String field_name,
    String wire_name
  ): HttpFieldBindingDef {
    return http_field_binding(
      contract_id,
      field_name,
      wire_name,
      http_cookie_location()
    );
  }

  pub fnc field(
    String name,
    int number,
    String number_text,
    TypeRef type_value,
    bool required,
    bool repeated
  ): FieldDef {
    return new FieldDef(name, number, number_text, type_value, required, repeated);
  }

  pub fnc message(String name, Array<FieldDef> fields): MessageDef {
    let Array<FieldDef> copied = arr[];
    for (const field_value of fields) {
      copied.add(field_value);
    }
    return new MessageDef(name, copied);
  }

  pub fnc rpc_method(
    int contract_id,
    String service,
    String name,
    String operation_id,
    String request_type,
    String response_type
  ): RpcMethodDef {
    return new RpcMethodDef(
      contract_id,
      service,
      name,
      operation_id,
      request_type,
      response_type,
      0
    );
  }

  pub fnc streaming_rpc_method(
    int contract_id,
    String service,
    String name,
    String operation_id,
    String request_type,
    String response_type,
    int streaming_kind
  ): RpcMethodDef {
    return new RpcMethodDef(
      contract_id,
      service,
      name,
      operation_id,
      request_type,
      response_type,
      streaming_kind
    );
  }

  pub fnc http_handler(
    String method,
    String path_template,
    int handler_id,
    int pipeline_id,
    int contract_id,
    String operation_id,
    String rpc_service,
    String rpc_name,
    String request_type,
    String response_type
  ): HttpHandlerDef {
    return new HttpHandlerDef(
      method,
      path_template,
      handler_id,
      pipeline_id,
      contract_id,
      operation_id,
      rpc_service,
      rpc_name,
      request_type,
      response_type,
      0
    );
  }

  pub fnc streaming_http_handler(
    String method,
    String path_template,
    int handler_id,
    int pipeline_id,
    int contract_id,
    String operation_id,
    String rpc_service,
    String rpc_name,
    String request_type,
    String response_type,
    int streaming_kind
  ): HttpHandlerDef {
    return new HttpHandlerDef(
      method,
      path_template,
      handler_id,
      pipeline_id,
      contract_id,
      operation_id,
      rpc_service,
      rpc_name,
      request_type,
      response_type,
      streaming_kind
    );
  }

  pub fnc rpc_from_http(&HttpHandlerDef handler_value): RpcMethodDef {
    return new RpcMethodDef(
      handler_value.contract_id,
      handler_value.rpc_service,
      handler_value.rpc_name,
      handler_value.operation_id,
      handler_value.request_type,
      handler_value.response_type,
      handler_value.streaming_kind
    );
  }

  pub fnc http_from_rpc(
    &RpcMethodDef method_value,
    String http_method,
    String path_template,
    int handler_id,
    int pipeline_id
  ): HttpHandlerDef {
    return new HttpHandlerDef(
      http_method,
      path_template,
      handler_id,
      pipeline_id,
      method_value.contract_id,
      method_value.operation_id,
      method_value.service,
      method_value.name,
      method_value.request_type,
      method_value.response_type,
      method_value.streaming_kind
    );
  }

  pub fnc builder(): ContractBuilder {
    return new ContractBuilder();
  }


  // ------------------------------------------------------------------------
  // Native code generation
  // ------------------------------------------------------------------------

  // A generator document is a sequence of String fragments. Consumers can
  // stream fragments directly to a file/socket/stdout without Java
  // StringBuilder interop or requiring String concatenation in the core.
  pub define class TextDocument as
    let Array<String> parts_value = arr[];

    pub write(String value): void {
      self.parts_value.add(value);
      return;
    }

    pub space(): void {
      self.parts_value.add(" ");
      return;
    }

    pub newline(): void {
      self.parts_value.add("\n");
      return;
    }

    pub line(String value): void {
      self.parts_value.add(value);
      self.parts_value.add("\n");
      return;
    }

    pub part_count(): int {
      return self.parts_value.size;
    }

    pub part_at(int index): String {
      return self.parts_value.get(index);
    }

    pub has_part(String expected): bool {
      for (const part of self.parts_value) {
        if part == expected; then
          return true;
        fi
      }
      return false;
    }
  end

  pub define class GeneratedBundle as
    pub val TextDocument json_schema;
    pub val TextDocument protobuf;
    pub val TextDocument messagepack;
    pub val TextDocument typespec;
  end

  fnc emit_json_type(&mut TextDocument out, int type_kind, String type_name): void {
    if type_kind == 0; then
      out.write("{\"type\":\"string\"}");
    elseif type_kind == 1; then
      out.write("{\"type\":\"boolean\"}");
    elseif type_kind == 2 || type_kind == 3; then
      out.write("{\"type\":\"integer\"}");
    elseif type_kind == 4 || type_kind == 5; then
      out.write("{\"type\":\"number\"}");
    elseif type_kind == 6; then
      out.write("{\"type\":\"string\",\"contentEncoding\":\"base64\"}");
    elseif type_kind == 7; then
      out.write("{\"$ref\":\"#/$defs/");
      out.write(type_name);
      out.write("\"}");
    elseif type_kind == 8; then
      out.write("{\"type\":\"string\",\"format\":\"date-time\"}");
    else
      out.write("{}");
    fi
    return;
  }

  fnc emit_proto_type(&mut TextDocument out, int type_kind, String type_name): void {
    if type_kind == 0; then
      out.write("string");
    elseif type_kind == 1; then
      out.write("bool");
    elseif type_kind == 2; then
      out.write("int32");
    elseif type_kind == 3; then
      out.write("int64");
    elseif type_kind == 4; then
      out.write("float");
    elseif type_kind == 5; then
      out.write("double");
    elseif type_kind == 6; then
      out.write("bytes");
    elseif type_kind == 7; then
      out.write(type_name);
    elseif type_kind == 8; then
      out.write("google.protobuf.Timestamp");
    else
      out.write("google.protobuf.Value");
    fi
    return;
  }

  fnc emit_typespec_type(&mut TextDocument out, int type_kind, String type_name): void {
    if type_kind == 0; then
      out.write("string");
    elseif type_kind == 1; then
      out.write("boolean");
    elseif type_kind == 2; then
      out.write("int32");
    elseif type_kind == 3; then
      out.write("int64");
    elseif type_kind == 4; then
      out.write("float32");
    elseif type_kind == 5; then
      out.write("float64");
    elseif type_kind == 6; then
      out.write("bytes");
    elseif type_kind == 7; then
      out.write(type_name);
    elseif type_kind == 8; then
      out.write("utcDateTime");
    else
      out.write("unknown");
    fi
    return;
  }

  fnc emit_msgpack_type(&mut TextDocument out, int type_kind, String type_name): void {
    if type_kind == 0; then
      out.write("str");
    elseif type_kind == 1; then
      out.write("bool");
    elseif type_kind == 2 || type_kind == 3; then
      out.write("int");
    elseif type_kind == 4 || type_kind == 5; then
      out.write("float");
    elseif type_kind == 6; then
      out.write("bin");
    elseif type_kind == 7; then
      out.write(type_name);
    elseif type_kind == 8; then
      out.write("timestamp");
    else
      out.write("any");
    fi
    return;
  }

  pub fnc json_schema(&ContractSet contracts, String schema_id): TextDocument {
    let TextDocument out = new TextDocument();
    out.line("{");
    out.write("  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",");
    out.newline();
    out.write("  \"$id\": \"");
    out.write(schema_id);
    out.write("\",");
    out.newline();
    out.line("  \"$defs\": {");

    for (let int message_index = 0; message_index < contracts.message_count(); message_index = message_index + 1) {
      val MessageDef message_value = contracts.message_at(message_index);
      out.write("    \"");
      out.write(message_value.name);
      out.line("\": {");
      out.line("      \"type\": \"object\",");
      out.line("      \"additionalProperties\": false,");
      out.line("      \"properties\": {");

      for (let int field_index = 0; field_index < message_value.field_count(); field_index = field_index + 1) {
        val FieldDef field_value = message_value.field_at(field_index);
        out.write("        \"");
        out.write(field_value.name);
        out.write("\": ");

        if field_value.repeated; then
          out.write("{\"type\":\"array\",\"items\":");
          emit_json_type(&mut out, field_value.type_kind(), field_value.type_name());
          out.write("}");
        else
          emit_json_type(&mut out, field_value.type_kind(), field_value.type_name());
        fi

        if field_index + 1 < message_value.field_count(); then
          out.write(",");
        fi
        out.newline();
      }

      out.line("      },");

      let int required_count = 0;
      for (let int required_index = 0; required_index < message_value.field_count(); required_index = required_index + 1) {
        if message_value.field_at(required_index).required; then
          required_count = required_count + 1;
        fi
      }

      out.write("      \"required\": [");
      let int emitted_required = 0;
      for (let int required_index = 0; required_index < message_value.field_count(); required_index = required_index + 1) {
        val FieldDef required_field = message_value.field_at(required_index);
        if required_field.required; then
          if emitted_required > 0; then
            out.write(", ");
          fi
          out.write("\"");
          out.write(required_field.name);
          out.write("\"");
          emitted_required = emitted_required + 1;
        fi
      }
      out.newline();
      out.write("      ]");
      out.newline();
      out.write("    }");
      if message_index + 1 < contracts.message_count(); then
        out.write(",");
      fi
      out.newline();
    }

    out.line("  }");
    out.line("}");
    return out;
  }

  pub fnc protobuf(&ContractSet contracts, String package_name): TextDocument {
    let TextDocument out = new TextDocument();
    out.line("syntax = \"proto3\";");
    out.write("package ");
    out.write(package_name);
    out.line(";");
    out.newline();
    out.line("import \"google/protobuf/struct.proto\";");
    out.line("import \"google/protobuf/timestamp.proto\";");
    out.newline();

    for (let int message_index = 0; message_index < contracts.message_count(); message_index = message_index + 1) {
      val MessageDef message_value = contracts.message_at(message_index);
      out.write("message ");
      out.write(message_value.name);
      out.line(" {");

      for (let int field_index = 0; field_index < message_value.field_count(); field_index = field_index + 1) {
        val FieldDef field_value = message_value.field_at(field_index);
        out.write("  ");
        if field_value.repeated; then
          out.write("repeated ");
        elseif !field_value.required; then
          out.write("optional ");
        fi
        emit_proto_type(&mut out, field_value.type_kind(), field_value.type_name());
        out.space();
        out.write(field_value.name);
        out.write(" = ");
        out.write(field_value.number_text);
        out.line(";");
      }

      out.line("}");
      out.newline();
    }

    // Emit one service block per unique service name.
    for (let int method_index = 0; method_index < contracts.method_count(); method_index = method_index + 1) {
      val RpcMethodDef method_value = contracts.method_at(method_index);
      let bool seen = false;
      for (let int earlier = 0; earlier < method_index; earlier = earlier + 1) {
        if contracts.method_at(earlier).service == method_value.service; then
          seen = true;
        fi
      }

      if !seen; then
        out.write("service ");
        out.write(method_value.service);
        out.line(" {");

        for (let int sibling_index = 0; sibling_index < contracts.method_count(); sibling_index = sibling_index + 1) {
          val RpcMethodDef sibling = contracts.method_at(sibling_index);
          if sibling.service == method_value.service; then
            out.write("  rpc ");
            out.write(sibling.name);
            out.write("(");
            if sibling.streaming_kind == 2 || sibling.streaming_kind == 3; then
              out.write("stream ");
            fi
            out.write(sibling.request_type);
            out.write(") returns (");
            if sibling.streaming_kind == 1 || sibling.streaming_kind == 3; then
              out.write("stream ");
            fi
            out.write(sibling.response_type);
            out.line(");");
          fi
        }

        out.line("}");
        out.newline();
      fi
    }

    return out;
  }

  // MessagePack has no universally adopted schema IDL equivalent to .proto.
  // This library therefore emits a deliberately tiny shared mpackdef v1.
  // Integer field numbers are canonical map keys, making schema evolution and
  // polyglot code generation deterministic.
  pub fnc messagepack_defs(&ContractSet contracts): TextDocument {
    let TextDocument out = new TextDocument();
    out.line("mpackdef 1");
    out.line("encoding map-int-keys");
    out.newline();

    for (let int message_index = 0; message_index < contracts.message_count(); message_index = message_index + 1) {
      val MessageDef message_value = contracts.message_at(message_index);
      out.write("message ");
      out.write(message_value.name);
      out.line(" {");

      for (let int field_index = 0; field_index < message_value.field_count(); field_index = field_index + 1) {
        val FieldDef field_value = message_value.field_at(field_index);
        out.write("  ");
        out.write(field_value.number_text);
        out.space();
        out.write(field_value.name);
        out.write(": ");
        if field_value.repeated; then
          out.write("array<");
          emit_msgpack_type(&mut out, field_value.type_kind(), field_value.type_name());
          out.write(">");
        else
          emit_msgpack_type(&mut out, field_value.type_kind(), field_value.type_name());
        fi
        if field_value.required; then
          out.write(" required");
        else
          out.write(" optional");
        fi
        out.newline();
      }

      out.line("}");
      out.newline();
    }

    for (let int method_index = 0; method_index < contracts.method_count(); method_index = method_index + 1) {
      val RpcMethodDef method_value = contracts.method_at(method_index);
      out.write("rpc ");
      out.write(method_value.service);
      out.write(".");
      out.write(method_value.name);
      out.write("(");
      out.write(method_value.request_type);
      out.write(") -> ");
      out.write(method_value.response_type);
      if method_value.streaming_kind != 0; then
        out.write(" streaming=");
        if method_value.streaming_kind == 1; then
          out.write("server");
        elseif method_value.streaming_kind == 2; then
          out.write("client");
        else
          out.write("bidi");
        fi
      fi
      out.newline();
    }

    return out;
  }

  pub fnc typespec(&ContractSet contracts, String namespace_name): TextDocument {
    let TextDocument out = new TextDocument();
    out.line("import \"@typespec/http\";");
    out.write("using TypeSpec.Http;");
    out.newline();
    out.write("namespace ");
    out.write(namespace_name);
    out.line(";");
    out.newline();

    for (let int message_index = 0; message_index < contracts.message_count(); message_index = message_index + 1) {
      val MessageDef message_value = contracts.message_at(message_index);
      out.write("model ");
      out.write(message_value.name);
      out.line(" {");

      for (let int field_index = 0; field_index < message_value.field_count(); field_index = field_index + 1) {
        val FieldDef field_value = message_value.field_at(field_index);
        out.write("  ");
        out.write(field_value.name);
        if !field_value.required; then
          out.write("?");
        fi
        out.write(": ");
        if field_value.repeated; then
          emit_typespec_type(&mut out, field_value.type_kind(), field_value.type_name());
          out.write("[]");
        else
          emit_typespec_type(&mut out, field_value.type_kind(), field_value.type_name());
        fi
        out.line(";");
      }

      out.line("}");
      out.newline();
    }

    // Build an operation-specific HTTP request projection. Explicit path,
    // query, header, and cookie fields become TypeSpec metadata; all unbound
    // request fields remain body data under TypeSpec's normal HTTP rules.
    for (let int method_index = 0; method_index < contracts.method_count(); method_index = method_index + 1) {
      val RpcMethodDef method_value = contracts.method_at(method_index);
      val Option<HttpHandlerDef> http_value = contracts.http_by_contract(method_value.contract_id);

      if http_value.is_some(); then
        val Option<MessageDef> request_message_value = contracts.message_named(method_value.request_type);
        if request_message_value.is_some(); then
          val MessageDef request_message = request_message_value.unwrap();

          out.write("model ");
          out.write(method_value.service);
          out.write("_");
          out.write(method_value.name);
          out.line("_HttpRequest {");

          for (let int field_index = 0; field_index < request_message.field_count(); field_index = field_index + 1) {
            val FieldDef field_value = request_message.field_at(field_index);
            val Option<HttpFieldBindingDef> binding_value =
              contracts.http_field_binding(method_value.contract_id, field_value.name);

            if binding_value.is_some(); then
              val HttpFieldBindingDef binding = binding_value.unwrap();
              if binding.location == 0; then
                out.write("  @path(\"");
              elseif binding.location == 1; then
                out.write("  @query(\"");
              elseif binding.location == 2; then
                out.write("  @header(\"");
              else
                out.write("  @cookie(\"");
              fi
              out.write(binding.wire_name);
              out.line("\")");
            fi

            out.write("  ");
            out.write(field_value.name);
            if !field_value.required; then
              out.write("?");
            fi
            out.write(": ");
            if field_value.repeated; then
              emit_typespec_type(&mut out, field_value.type_kind(), field_value.type_name());
              out.write("[]");
            else
              emit_typespec_type(&mut out, field_value.type_kind(), field_value.type_name());
            fi
            out.line(";");
          }

          out.line("}");
          out.newline();
        fi
      fi
    }

    // TypeSpec operations are scoped by RPC service so identical method names
    // in different services remain distinct, exactly like protobuf services.
    for (let int method_index = 0; method_index < contracts.method_count(); method_index = method_index + 1) {
      val RpcMethodDef first_method = contracts.method_at(method_index);
      let bool service_seen = false;
      for (let int earlier = 0; earlier < method_index; earlier = earlier + 1) {
        if contracts.method_at(earlier).service == first_method.service; then
          service_seen = true;
        fi
      }

      if !service_seen; then
        out.write("interface ");
        out.write(first_method.service);
        out.line(" {");

        for (let int sibling_index = 0; sibling_index < contracts.method_count(); sibling_index = sibling_index + 1) {
          val RpcMethodDef method_value = contracts.method_at(sibling_index);
          if method_value.service == first_method.service; then
            val Option<HttpHandlerDef> http_value = contracts.http_by_contract(method_value.contract_id);
            val bool has_http_binding = http_value.is_some();

            if has_http_binding; then
              val HttpHandlerDef handler_value = http_value.unwrap();
              out.write("@route(\"");
              out.write(handler_value.path_template);
              out.line("\")");
              if handler_value.method == "GET"; then
                out.line("@get");
              elseif handler_value.method == "POST"; then
                out.line("@post");
              elseif handler_value.method == "PUT"; then
                out.line("@put");
              elseif handler_value.method == "PATCH"; then
                out.line("@patch");
              elseif handler_value.method == "DELETE"; then
                out.line("@delete");
              elseif handler_value.method == "HEAD"; then
                out.line("@head");
              fi
            fi

            out.write("op ");
            out.write(method_value.name);
            if has_http_binding; then
              out.write("(...");
              out.write(method_value.service);
              out.write("_");
              out.write(method_value.name);
              out.write("_HttpRequest");
            else
              out.write("(request: ");
              out.write(method_value.request_type);
            fi
            out.write("): ");
            out.write(method_value.response_type);
            out.line(";");
            out.newline();
          fi
        }

        out.line("}");
        out.newline();
      fi
    }

    return out;
  }

  pub fnc generate_all(
    &ContractSet contracts,
    String json_schema_id,
    String proto_package,
    String typespec_namespace
  ): GeneratedBundle {
    return new GeneratedBundle(
      json_schema(contracts, json_schema_id),
      protobuf(contracts, proto_package),
      messagepack_defs(contracts),
      typespec(contracts, typespec_namespace)
    );
  }

end
