async fnc source(): int {
    return 20;
}

async fnc plus_one_async(int value): int {
    return value + 1;
}

fnc twice(int value): int {
    return value * 2;
}

pub fnc main(): int {
    let Future<int> pending = rt take source() |> plus_one_async() |> twice();
    let int result = await pending;
    return result;
}
