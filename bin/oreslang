#!/usr/bin/env python3
"""Compatibility dispatcher: oreslang test without changing the core launcher."""
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

if len(sys.argv) >= 2 and sys.argv[1] == "test":
    from oreslang_test.cli import main
    sys.exit(main(sys.argv[2:]))

core = os.environ.get("ORESLANG_BIN", "oreslang-core")
if Path(core).resolve() == Path(__file__).resolve():
    print("ORESLANG_BIN resolves to wrapper; recursion refused", file=sys.stderr)
    sys.exit(2)
try:
    os.execvp(core, [core, *sys.argv[1:]])
except OSError as exc:
    print(f"cannot delegate to Oreslang core: {exc}", file=sys.stderr)
    sys.exit(2)
